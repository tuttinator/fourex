# Public FastAPI base URL — inlined into the client bundle at build time.
# Note the /api/v1 suffix; `next build` will fail without this set.
NEXT_PUBLIC_API_URL=http://localhost:8010/api/v1

# Server-side FastAPI base for the Auth.js identity adapter.
# The adapter appends /api/v1/identities/... itself, so no suffix here.
INTERNAL_API_URL=http://localhost:8010

# HS256 secret shared with the backend (must match backend/.env AUTH_SECRET).
# Generate with: openssl rand -hex 32
AUTH_SECRET=replace-with-32-plus-byte-secret

# Shared secret for /api/v1/identities/* (must match backend/.env IDENTITY_SERVICE_SECRET).
# Generate with: openssl rand -hex 32
IDENTITY_SERVICE_SECRET=replace-with-service-secret

# Resend API key for magic-link sign-in. Get one at https://resend.com.
AUTH_RESEND_KEY=re_your_resend_api_key

# Verified Resend sender. Defaults to onboarding@resend.dev (Resend's
# sandbox sender) if unset — fine for local dev.
AUTH_EMAIL_FROM=onboarding@resend.dev
